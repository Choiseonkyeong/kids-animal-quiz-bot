# Claude API (대본 생성)
ANTHROPIC_API_KEY=
# Google Cloud Text-to-Speech API 키 (TTS)
GOOGLE_TTS_API_KEY=
# OpenAI API 키 (gpt-image-1 이미지 생성). 비워 두면 assets/images/ 로컬 이미지만 사용
OPENAI_API_KEY=
# 업로드 공개 상태: private | unlisted | public (기본 private)
YOUTUBE_PRIVACY_STATUS=private
# (선택) 모델 변경
# CLAUDE_MODEL=claude-opus-5-5
